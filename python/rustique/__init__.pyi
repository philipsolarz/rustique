@final
class List[T](MutableSequence[T]):
    """A `list` with native storage: `List([1, 2])`, `List[int](...)`, `List[u8](...)`."""

    __hash__: ClassVar[None]  # type: ignore[assignment]
    @overload
    def __init__(self, /) -> None: ...
    @overload
    def __init__(self, iterable: Iterable[T], /) -> None: ...
    @overload  # nested: List[List[E]] converts any iterable of iterables
    def __init__[E](self: List[List[E]], iterable: Iterable[Iterable[E]], /) -> None: ...
    @overload  # marker: List[u8](ints)
    def __init__[I: (i8, i16, i32, i64, u8, u16, u32, u64)](self: List[I], iterable: Iterable[int | I], /) -> None: ...
    @overload  # marker: List[f32](floats)
    def __init__[F: (f32, f64)](self: List[F], iterable: Iterable[float | F], /) -> None: ...
    @property
    def strategy(self) -> _Strategy: ...
    @property
    def schema_type(self) -> ListType | type[List[Any]]: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __contains__(self, value: object, /) -> bool: ...
    @overload  # type: ignore[override]  # marker: reads of List[u8] are Python ints
    def __getitem__[I: (i8, i16, i32, i64, u8, u16, u32, u64)](self: List[I], index: SupportsIndex, /) -> int: ...
    @overload  # marker
    def __getitem__[F: (f32, f64)](self: List[F], index: SupportsIndex, /) -> float: ...
    @overload
    def __getitem__(self, index: SupportsIndex, /) -> T: ...
    @overload
    def __getitem__(self, index: slice, /) -> List[T]: ...  # pyright: ignore[reportIncompatibleMethodOverride]
    @overload  # marker
    def __setitem__[I: (i8, i16, i32, i64, u8, u16, u32, u64)](self: List[I], index: SupportsIndex, value: int | I, /) -> None: ...
    @overload  # marker
    def __setitem__[F: (f32, f64)](self: List[F], index: SupportsIndex, value: float | F, /) -> None: ...
    @overload
    def __setitem__(self, index: SupportsIndex, value: T, /) -> None: ...
    @overload
    def __setitem__(self, index: slice, value: Iterable[T], /) -> None: ...  # pyright: ignore[reportIncompatibleMethodOverride]
