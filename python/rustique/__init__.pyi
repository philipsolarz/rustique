"""Type stubs for Rustique (hand-written; ARCHITECTURE §4).

Element types: ``List[T]``/``Set[T]``/``Dict[K, V]`` are generic in the type of the
elements *as Python sees them*. The fixed-width scalar classes (``u8``, ``f32``, ...)
double as element-type markers: ``List[u8]`` stores bytes natively, accepts ``int`` (and
``u8``) and returns plain ``int`` on reads. The overloads marked "marker" below encode
that, so ``List[u8]([1, 2])[0]`` is an ``int`` and ``List[f32]`` reads are ``float``.

At runtime ``List[int]`` is a cached ``ListType`` alias object (``schema``, ``__args__``,
``isinstance`` support); type checkers see the specialised generic class instead.
"""

import sys
from collections.abc import (
    Callable,
    ItemsView,
    Iterable,
    Iterator,
    KeysView,
    MutableMapping,
    MutableSequence,
    MutableSet,
    ValuesView,
)
from collections.abc import Set as AbstractSet
from types import UnionType
from typing import (
    Any,
    ClassVar,
    Final,
    Literal,
    NoReturn,
    Protocol,
    Self,
    SupportsFloat,
    SupportsIndex,
    final,
    overload,
    type_check_only,
)

__all__ = [
    "Dict",
    "DictType",
    "Expr",
    "List",
    "ListType",
    "Set",
    "SetType",
    "X",
    "__version__",
    "arange",
